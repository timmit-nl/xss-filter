parameters:
	level: 9
	parallel:
		maximumNumberOfProcesses: 4
		minimumNumberOfJobsPerProcess: 2
		jobSize: 2
		processTimeout: 120.0
	fileExtensions:
		- php
	paths:
		- ./src
	excludePaths:
	dynamicConstantNames:
	treatPhpDocTypesAsCertain: false
includes:
	- vendor/phpstan/phpstan-deprecation-rules/rules.neon
